---
// Fonts are served from here, not a font service: no render-blocking third
// party, and nothing about a visitor leaves the server.
import "../styles/base.css";

const MAC = "https://github.com/alcun/heyra-desktop";
const MAC_CODE = "https://github.com/alcun/heyra-desktop";
const SERVER_CODE = "https://github.com/alcun/heyra";
// One list for the page and for search engines' FAQ data.
const faq = [
  ["Does Heyra need the internet?", "Once, to download a speech model (300 to 490 MB). After that it works with no network at all."],
  ["Which Macs does it run on?", "Macs with Apple Silicon (M1 or later) on macOS 13 or later."],
  ["Which languages does it understand?", "English with any model. Pick Parakeet v3 for 24 other European languages, including French, German, Spanish and Italian; it works out which one you're speaking."],
  ["How is it different from the dictation built into macOS?", "Heyra works in any app by holding one key, uses the open speech model you pick, keeps a history you can copy from, and has a dictionary for the words it gets wrong. And it's open source."],
  ["Is it really free?", "Yes. It's MIT licensed, with no account and no paid tier."],
  ["Does it work on Windows or Linux?", "Not yet. A Windows version is planned."],
  ["What happens to my voice in the demo on this page?", "The demo sends your clip to this server, which writes it down in memory and doesn't keep the audio. The Mac app sends nothing."],
];
import Analytics from "../components/Analytics.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
const analyticsKey = import.meta.env.HEYRA_LOGGERLIZARD_KEY;
const credit = import.meta.env.HEYRA_CREDIT_URL;
const site = Astro.site;
const canonical = site ? new URL("/", site).href : undefined;
const og = site ? new URL("/og.png", site).href : undefined;
const curl = `curl http://localhost:3000/v1/transcribe \\
  --data-binary @clip.wav

{ "text": "Draw me a cat in a hat.", "seconds": 2.4, "ms": 231 }`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Heyra · Dictation that runs on your Mac</title>
  {canonical && <link rel="canonical" href={canonical} />}
  <meta name="description" content="Hold a key, talk, let go. Free, open source voice to text that never leaves your Mac." />
  <meta name="color-scheme" content="dark" />
  <meta name="theme-color" content="#121318" />
  <link rel="preload" href="/fonts/Outland-Bold.otf" as="font" type="font/otf" crossorigin />
  <link rel="preload" href="/fonts/SpaceGrotesk-Regular.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/MartianMono-StdMd.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
  <meta property="og:type" content="website" />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:title" content="Heyra · Dictation that runs on your Mac" />
  {og && <meta property="og:image" content={og} />}
  {og && <meta name="twitter:card" content="summary_large_image" />}
  <meta property="og:description" content="Hold a key, talk, let go. Speech to text that runs on your own Mac." />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="How to use this API" />
  {analyticsKey && <Analytics publicKey={analyticsKey} />}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "SoftwareApplication", name: "Heyra",
    description: "Push-to-talk dictation that runs on your Mac with open speech models, plus a self-hosted speech-to-text API.",
    applicationCategory: "UtilitiesApplication", operatingSystem: "macOS (Apple Silicon)",
    license: "https://opensource.org/licenses/MIT", codeRepository: MAC_CODE,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "FAQPage",
    mainEntity: faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
  })} />
  <style is:global>
    /* ---- hero ---- */
    .hero {
      position: relative; min-height: 100svh; display: grid; place-items: center; text-align: center;
      padding: 7.5rem 1rem 5rem; isolation: isolate; z-index: 3;
    }
    .hero-inner { position: relative; width: 100%; max-width: 80rem; }
    /* A faint field of stars behind the orb. */
    .sky { position: absolute; inset: 0; z-index: -1; pointer-events: none; overflow: hidden;
      background:
        radial-gradient(1px 1px at 12% 22%, rgb(237 224 196 / 0.35), transparent 60%),
        radial-gradient(1px 1px at 78% 14%, rgb(237 224 196 / 0.25), transparent 60%),
        radial-gradient(1px 1px at 64% 72%, rgb(237 224 196 / 0.22), transparent 60%),
        radial-gradient(1px 1px at 28% 81%, rgb(237 224 196 / 0.2), transparent 60%),
        radial-gradient(1.5px 1.5px at 88% 58%, rgb(217 168 106 / 0.35), transparent 60%),
        radial-gradient(1px 1px at 41% 9%, rgb(237 224 196 / 0.2), transparent 60%),
        radial-gradient(1px 1px at 6% 61%, rgb(237 224 196 / 0.18), transparent 60%),
        radial-gradient(1px 1px at 93% 88%, rgb(237 224 196 / 0.2), transparent 60%),
        radial-gradient(120% 80% at 50% 0%, #17181f 0%, var(--ground) 60%);
    }
    #ascii-wave { position: absolute; inset: 17% 0 17%; width: 100%; height: 66%;
      -webkit-mask-image: radial-gradient(ellipse 11% 32% at 50% 50%, transparent 0%, #000 100%);
      mask-image: radial-gradient(ellipse 11% 32% at 50% 50%, transparent 0%, #000 100%);
    }
    .stage { position: relative; width: min(22rem, 70vw, 34svh); aspect-ratio: 1; margin: 1rem auto -1rem; }
    #orb { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
    #orb.no-gl { background: radial-gradient(circle at 50% 50%, #000 0 33%, rgb(217 168 106 / 0.18) 34%, transparent 60%); border-radius: 50%; }
    #stone {
      position: absolute; inset: 21%; border-radius: 50%; border: 0; background: transparent; cursor: pointer;
      touch-action: none; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none;
      transition: transform 0.2s ease;
    }
    #stone:disabled { cursor: default; }
    #stone.held { transform: scale(0.98); }
    #stone .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    h1 {
      margin: 0; font: 700 clamp(1.9rem, 4.2vw, 3.6rem)/1.12 var(--display);
      letter-spacing: 0.05em; text-wrap: balance;
    }
    h1 em { font-style: normal; color: var(--gold); }
    /* The big name: the mark is its h, as far from the e as the letters are apart. */
    .wordmark { display: inline-flex; align-items: center; gap: 0.16em; margin: 0; color: var(--cream); font: 700 clamp(3.2rem, 9vw, 7.2rem)/1 var(--display); letter-spacing: 0.12em; }
    .wordmark svg { width: 0.98em; height: 0.98em; flex: none; }
    .wordmark span { margin-right: -0.12em; }
    /* Down to the rest: a chevron, no word. */
    .scroll { position: absolute; left: 50%; bottom: 1.5rem; translate: -50% 0; display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 50%; color: var(--dim); transition: color 0.2s ease; }
    .scroll:hover { color: var(--cream); }
    .scroll svg { width: 1.4rem; height: 1.4rem; }
    /* The orb lands as the dot above the Dock: one gold pulse. */
    .orb-landed .scene-orb { animation: landed 1s ease-out 1; }
    @keyframes landed { 30% { filter: drop-shadow(0 0 12px rgb(217 168 106 / 0.9)); } to { filter: none; } }
    .hero .lede { margin-top: 1.4rem; font-size: clamp(1.05rem, 1.7vw, 1.25rem); color: var(--slate); }
    .lede { margin: 1.25rem auto 0; max-width: 40rem; color: var(--slate); font-size: clamp(1.05rem, 1.8vw, 1.25rem); line-height: 1.5; text-wrap: balance; }
    .brew-row { margin: 0.25rem 0 1.75rem; }
    @media (max-width: 640px) { .brew-row { display: none; } }
    .actions { align-items: center; display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; margin-top: 0.5rem; }
    .fine { margin: 1rem 0 0; font: 400 0.78rem/1.5 var(--mono); color: var(--dim); }
    .fine a { color: var(--slate); }
    #status { min-height: 1.5em; margin: -1.25rem auto 0; font: 500 0.78rem/1.5 var(--mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--slate); }
    #status kbd {
      display: inline-block; margin: 0 0.35em; padding: 0.25em 0.55em 0.2em; border-radius: 6px;
      background: linear-gradient(#25272f, #1b1d23); border: 1px solid #353845; box-shadow: 0 2px 0 #0b0c10;
      font: 500 0.95em/1 var(--mono); color: var(--cream); letter-spacing: 0.04em; text-transform: none;
    }
    #status::before {
      content: ""; display: inline-block; width: 0.45rem; height: 0.45rem; margin-right: 0.6rem; vertical-align: 0.08em;
      border-radius: 50%; background: var(--dim);
    }
    body[data-demo="up"] #status::before { background: #8fbf8a; box-shadow: 0 0 10px rgb(143 191 138 / 0.6); }
    body[data-demo="down"] #status::before { background: #c9705a; }
    .hero:has(#stone.listening) #status::before { background: var(--gold); box-shadow: 0 0 12px rgb(217 168 106 / 0.8); }
    /* The newest take is large, the one before it small and dim. */
    #heard { list-style: none; padding: 0; margin: 0.4rem auto 0; max-width: 40rem; height: 4.2rem; overflow: hidden; }
    #heard li { display: none; }
    #heard li q { quotes: none; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; cursor: copy; }
    #heard li:first-child { display: block; color: var(--cream); }
    #heard li:first-child q { font: 500 clamp(1.1rem, 2.4vw, 1.4rem)/1.35 var(--sans); letter-spacing: -0.01em; }
    #heard li:first-child span { display: block; margin-top: 0.3rem; font: 400 0.75rem/1.4 var(--mono); color: var(--slate); }
    #heard li:nth-child(2) { display: block; margin-top: 0.6rem; color: var(--dim); }
    #heard li:nth-child(2) q { font: 400 1rem/1.5 var(--sans); }
    #heard li:nth-child(2) span { display: none; }
    @media (prefers-reduced-motion: no-preference) {
      #heard li:first-child { animation: arrive 0.5s var(--ease); }
      @keyframes arrive { from { opacity: 0; transform: translateY(8px); filter: blur(4px); } }
    }
    #key { display: flex; gap: 0.75rem; max-width: 26rem; margin: 1.5rem 0 0; }
    #key[hidden] { display: none; }
    #key input { flex: 1; min-width: 0; font: 400 0.9rem/1 var(--mono); color: var(--cream); background: var(--panel); border: 1px solid var(--hair); border-radius: 999px; padding: 0.7rem 1rem; }
    button.plain { font: 500 0.75rem/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--slate); background: none; border: 1px solid var(--hair); border-radius: 999px; padding: 0.7rem 1rem; cursor: pointer; }
    .demo-note { margin: 2rem 0 0; max-width: 38rem; font-size: 0.95rem; line-height: 1.6; color: var(--dim); }
    code { font-family: var(--mono); font-size: 0.92em; overflow-wrap: anywhere; }

    /* ---- sections ---- */
    section.block { padding: clamp(4.5rem, 9vw, 7.5rem) 0; border-top: 1px solid var(--hair); overflow-x: clip; }
    h2 { margin: 0; font: 500 1.35rem/1.3 var(--sans); letter-spacing: 0; color: var(--cream); text-wrap: balance; max-width: 24ch; }
    .head { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 1rem clamp(2rem, 5vw, 5rem); align-items: baseline; margin-bottom: 2.5rem; }
    .head .intro { margin: 0; }
    .intro { margin: 1rem 0 0; max-width: 34rem; color: var(--slate); font-size: 1.1rem; }


    .spec { display: flex; flex-wrap: wrap; gap: 0.75rem 2.5rem; margin: 2rem 0 0; font: 400 0.98rem/1.5 var(--sans); color: var(--slate); font-variant-numeric: tabular-nums; }
    .spec b { font: 500 1em/1 var(--mono); color: var(--cream); }
    .spec span:first-child b { color: var(--gold); }
    .spec a { color: inherit; text-underline-offset: 3px; }

    /* split: words and picture */
    .split { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
    .shot { position: relative; border-radius: 16px; padding: 10px; background: var(--ground-2); border: 1px solid var(--hair); }
    .shot img { display: block; width: 100%; height: auto; border-radius: 10px; }
    .app-grid { display: block; }
    .app-grid figure, .pieces figure { margin: 0; }
    .app-grid figcaption, .pieces figcaption { margin-top: 0.85rem; font-size: 0.95rem; color: var(--slate); }
    .shot figcaption { padding: 0 0.25rem 0.25rem; }
    .pieces { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3.5rem); margin-top: clamp(2.5rem, 5vw, 4rem); align-items: start; }
    .pieces img { display: block; width: 100%; height: auto; }
    @media (max-width: 860px) { .pieces { grid-template-columns: minmax(0, 1fr); } }




    /* ---- the scene: a Mac screen ---- */
    .screen {
      position: relative; margin-top: 3rem; aspect-ratio: 16 / 10; border-radius: 18px; overflow: hidden;
      border: 1px solid var(--hair); box-shadow: 0 50px 100px -40px rgb(0 0 0 / 0.8), inset 0 0 0 1px rgb(255 255 255 / 0.03);
      background:
        radial-gradient(70% 60% at 75% 20%, rgb(154 148 180 / 0.35), transparent 70%),
        radial-gradient(60% 70% at 15% 85%, rgb(111 132 147 / 0.35), transparent 70%),
        radial-gradient(50% 50% at 50% 60%, rgb(217 168 106 / 0.12), transparent 70%),
        linear-gradient(160deg, #262833, #16171d);
    }
    .menubar { position: absolute; inset: 0 0 auto; height: 4.2%; min-height: 18px; display: flex; justify-content: space-between; align-items: center; padding: 0 1.4%; background: rgb(20 21 26 / 0.55); backdrop-filter: blur(12px); font: 500 clamp(0.5rem, 1vw, 0.78rem)/1 var(--sans); color: rgb(237 224 196 / 0.85); }
    .mb-left, .mb-right { display: flex; gap: 1.6em; align-items: center; }
    .mb-dot { width: 0.8em; height: 0.8em; border-radius: 50%; background: #000; box-shadow: 0 0 0 1px rgb(237 224 196 / 0.35); display: grid; place-items: center; }
    .mb-dot::after { content: ""; width: 0.2em; height: 0.2em; border-radius: 50%; background: var(--gold); }
    .window { position: absolute; border-radius: 12px; background: rgb(28 29 36 / 0.92); border: 1px solid rgb(255 255 255 / 0.06); box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.8); overflow: hidden; transition: transform 0.6s var(--ease), filter 0.6s ease, opacity 0.6s ease; z-index: 1; filter: brightness(0.72) saturate(0.8); transform: scale(0.97); }
    .window.focus { z-index: 2; filter: none; transform: none; border-color: rgb(237 224 196 / 0.14); box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.9); }
    .window.notes { left: 7%; top: 11%; width: 50%; height: 52%; }
    .window.term { right: 7%; top: 21%; width: 50%; height: 50%; background: rgb(14 15 19 / 0.95); }
    .tty { font-family: var(--mono) !important; font-size: clamp(0.62rem, 1.35vw, 1.02rem) !important; }
    .tty .dim { color: var(--slate); }
    .tty .prompt { color: var(--gold); }
    .titlebar { height: 13%; display: flex; align-items: center; gap: 0.5em; padding: 0 3%; border-bottom: 1px solid rgb(255 255 255 / 0.05); font: 500 clamp(0.5rem, 1vw, 0.75rem)/1 var(--sans); color: var(--slate); }
    .titlebar i { width: 0.75em; height: 0.75em; border-radius: 50%; background: #3a3d48; }
    .titlebar span { margin-left: auto; margin-right: auto; }
    .doc { padding: 5% 7%; font: 400 clamp(0.72rem, 1.7vw, 1.3rem)/1.45 var(--sans); color: var(--cream); letter-spacing: -0.01em; }
    .doc-line { margin: 0 0 0.6em; }
    .doc-line:first-child { font-weight: 600; color: var(--cream); }
    .doc-line:not(.now):not(:first-child) { color: rgb(237 224 196 / 0.62); }
    .doc-text.landed { animation: land 0.6s var(--ease); }
    @keyframes land { from { opacity: 0; filter: blur(6px); background: rgb(217 168 106 / 0.25); } }
    .caret { display: inline-block; width: 2px; height: 1.1em; margin-left: 2px; vertical-align: -0.15em; background: var(--gold); }
    @media (prefers-reduced-motion: no-preference) { .caret { animation: blink 1.1s steps(1) infinite; } @keyframes blink { 50% { opacity: 0; } } }
    .dock { position: absolute; left: 50%; bottom: 2%; translate: -50% 0; display: flex; gap: 0.8%; padding: 0.6%; width: 36%; border-radius: 16px; background: rgb(40 42 52 / 0.45); border: 1px solid rgb(255 255 255 / 0.08); backdrop-filter: blur(14px); }
    .dock i { flex: 1; aspect-ratio: 1; border-radius: 22%; background: linear-gradient(160deg, #3b3e4b, #23252e); box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06); }
    .dock i:nth-child(2) { background: linear-gradient(160deg, #6f8493, #3d4a55); }
    .dock i:nth-child(4) { background: linear-gradient(160deg, #d9a86a, #8d6233); }
    .dock i:nth-child(6) { background: linear-gradient(160deg, #9a94b4, #514c69); }
    .scene-orb { position: absolute; left: 50%; bottom: 9.5%; width: 14%; aspect-ratio: 1; translate: -50% 0; }
    .scene-wrap { position: relative; margin-top: 3rem; }
    .scene-wrap .screen { margin-top: 0; }
    .keys { display: flex; align-items: center; gap: 0.75rem; margin: 1.25rem 0 0 2%; }
    .keys span { font: 400 0.85rem/1 var(--sans); color: var(--dim); }
    .fnkey {
      display: grid; place-items: center; width: clamp(2.6rem, 6vw, 4.2rem); aspect-ratio: 1.1;
      border-radius: 12%; background: linear-gradient(#2a2c35, #1c1e25); border: 1px solid #3b3e4c;
      box-shadow: 0 4px 0 #0c0d11, inset 0 1px 0 #44475a; font: 500 clamp(0.6rem, 1.5vw, 1.05rem)/1 var(--mono); color: var(--cream);
      transition: transform 0.12s ease, box-shadow 0.12s ease, color 0.2s ease;
    }
    .fnkey.down { transform: translateY(3px); box-shadow: 0 1px 0 #0c0d11, inset 0 1px 0 #44475a; color: var(--gold); }


    /* privacy */


    .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

    /* section variety */
    .scene-wrap.wide { width: min(84rem, calc(100vw - 2 * max(1rem, 4vw))); margin-left: 50%; translate: -50% 0; margin-top: 3.5rem; }
    .split.flip { grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr); }

    .band { background: #0d0e12; border-top-color: #1d1f27; }
    .band pre { background: #08090c; overflow-x: auto; }
    @media (max-width: 860px) { .split.flip { grid-template-columns: minmax(0, 1fr); } .server-split > :first-child { order: 2; } }

    /* comparison */


    /* faq */
    .faq-wrap { display: grid; grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr); gap: clamp(2rem, 5vw, 5rem); }
    .faq details { border-top: 1px solid var(--hair); }
    .faq details:last-child { border-bottom: 1px solid var(--hair); }
    .faq summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: 1rem; padding: 1.15rem 0; font: 500 1.05rem/1.4 var(--sans); color: var(--cream); }
    .faq summary::-webkit-details-marker { display: none; }
    .faq summary::after { content: "+"; font: 400 1.2rem/1 var(--mono); color: var(--gold); transition: transform 0.25s ease; }
    .faq details[open] summary::after { transform: rotate(45deg); }
    .faq { interpolate-size: allow-keywords; }
    .faq details::details-content { block-size: 0; overflow: clip; transition: block-size 0.3s var(--ease), content-visibility 0.3s allow-discrete; }
    .faq details[open]::details-content { block-size: auto; }
    .faq details p { margin: 0 0 1.2rem; max-width: 38rem; color: var(--slate); }
    @media (max-width: 860px) { .faq-wrap { grid-template-columns: minmax(0, 1fr); } }

    /* motion: one entrance for the hero, a gentle rise as sections scroll in.
       The rise is movement only, never transparency, so a section is always fully
       visible, whatever captures it. Reduced motion turns both off. */
    @media (prefers-reduced-motion: no-preference) {
      .hero-inner > * { animation: enter 1s var(--ease) both; }
      .hero-inner > :nth-child(2) { animation-delay: 0.08s; }
      .hero-inner > :nth-child(3) { animation-delay: 0.16s; }
      .hero-inner > .stage { animation: bloom 1.6s var(--ease) 0.2s both; }
      .hero-inner > .actions, .hero-inner > .fine { animation-delay: 0.45s; }
      @keyframes enter { from { opacity: 0; transform: translateY(14px); filter: blur(6px); } }
      @keyframes bloom { from { opacity: 0; transform: scale(0.82); filter: blur(10px); } }
      @supports (animation-timeline: view()) {
        /* Sections: heading, then copy, then the visual, each easing into place. */
        section.block h2, .closing h2 {
          animation: rise both var(--ease); animation-timeline: view(); animation-range: entry 0% entry 70%;
        }
        section.block .intro, section.block .uses, section.block .faq, .closing .actions {
          animation: rise both var(--ease); animation-timeline: view(); animation-range: entry 0% entry 70%;
        }
        .screen, .shot, .server-split pre, .spec {
          animation: rise both var(--ease); animation-timeline: view(); animation-range: entry 0% entry 70%;
        }
        @keyframes rise { from { transform: translateY(16px); opacity: 0; } }

      }
    }

    /* developers */
    .uses { margin: 1rem 0 0; max-width: 34rem; color: var(--dim); }
    .hero:has(#stone.listening) #status { color: var(--gold); }
    .hero:has(#stone.thinking) #status { color: var(--cream); }

    .server-split { align-items: center; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); }
    .server-split pre { margin-top: 0; }
    pre { margin: 2rem 0 0; padding: 1.25rem 1.4rem; border-radius: 14px; background: #0d0e12; border: 1px solid var(--hair); overflow-x: auto; font: 400 0.85rem/1.7 var(--mono); color: var(--cream); }
    .dev-links { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2.25rem; }

    /* closing */
    .closing { text-align: center; padding: clamp(5rem, 10vw, 8rem) 0; border-top: 1px solid var(--hair); }
    .closing h2 { margin-inline: auto; font: 700 clamp(1.6rem, 3vw, 2.2rem)/1.2 var(--display); letter-spacing: 0.05em; }
    .closing .actions.closing-actions { margin-top: 2.75rem; }

    .credits { margin-top: 2.5rem; }
    .credits p { margin: 0; padding-top: 1.5rem; border-top: 1px solid var(--hair); font-size: 0.82rem; }
    .credits a { color: var(--slate); }

    @media (max-width: 860px) {
        .head { grid-template-columns: minmax(0, 1fr); }
      .split { grid-template-columns: minmax(0, 1fr); }
    }
    @media (max-width: 600px) {
      #status { height: 3em; }
    }
  </style>
</head>
<body>
  <Header hideInHero />

  <main>
    <section class="hero" aria-label="Heyra">
      <div class="sky" aria-hidden="true"><canvas id="ascii-wave"></canvas></div>
      <div class="hero-inner">
        <h1 class="wordmark" aria-label="Heyra">
          <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="2" y="2" width="4" height="16" rx="2" fill="currentColor"/><rect x="8" y="7" width="4" height="6" rx="2" fill="#d9a86a"/><rect x="14" y="2" width="4" height="16" rx="2" fill="currentColor"/></svg>
          <span aria-hidden="true">eyra</span>
        </h1>
        <p class="lede">Free, open source voice to text that never leaves your Mac.</p>

        <div class="stage">
          <canvas id="orb" aria-hidden="true"></canvas>
          <button id="stone" type="button" aria-describedby="status">
            <span class="sr">Hold to talk</span>
          </button>
        </div>
        <p id="status" role="status" aria-live="polite"></p>
        <ol id="heard" aria-label="What Heyra heard" reversed></ol>
        <div class="brew-row">
          <code class="brew"><span>$</span> brew install --cask alcun/tap/heyra
            <button type="button" id="copy-brew" aria-label="Copy the install command">
              <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.4" d="M5.5 5.5h7v7h-7zM10.5 5.5v-2h-7v7h2"/></svg>
            </button>
          </code>
        </div>
        <div class="actions">
          <a class="btn primary" href={MAC}>
            <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M11.2 8.5c0-1.6 1.3-2.4 1.4-2.5-.8-1.1-2-1.3-2.4-1.3-1-.1-2 .6-2.5.6s-1.3-.6-2.2-.6C4.3 4.7 3.2 5.4 2.6 6.5c-1.2 2.1-.3 5.2.9 6.9.6.8 1.2 1.7 2.1 1.7.8 0 1.2-.5 2.2-.5s1.3.5 2.2.5 1.5-.8 2-1.7c.6-.9.9-1.8.9-1.9-.1 0-1.7-.7-1.7-3zM9.6 3.6c.4-.5.8-1.3.7-2-.7 0-1.5.4-1.9 1-.4.5-.8 1.2-.7 2 .7 0 1.4-.4 1.9-1z"/></svg>
            Download for Mac
          </a>
        </div>

      </div>
      <a class="scroll" href="#how" aria-label="Scroll to see more">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M7 10l5 5 5-5"/></svg>
      </a>
    </section>

    <section class="block scene-block" id="how" aria-labelledby="scene-title">
      <div class="wrap">
        <div class="head">
          <h2 id="scene-title">Talk anywhere you can type</h2>
          <p class="intro">Hold fn in any app and say it. Let go, and it's typed where your cursor is.</p>
        </div>
        <div class="scene-wrap wide">
        <div class="screen" id="scene" role="img" aria-label="A Mac screen with Notes and a terminal. The Heyra dot sits above the Dock; when fn is held it grows into the orb, and the spoken sentence appears in whichever window is in front.">
          <div class="menubar" aria-hidden="true">
            <span class="mb-left"><b class="mb-app">Notes</b><span>File</span><span>Edit</span><span>View</span></span>
            <span class="mb-right"><i class="mb-dot"></i><span>Tue 9:41</span></span>
          </div>
          <div class="window notes focus" aria-hidden="true">
            <div class="titlebar"><i></i><i></i><i></i><span>Today</span></div>
            <div class="doc"><p class="doc-line">Notes from Tuesday</p><p class="doc-line now"><span class="doc-text">Call the printers about the proofs.</span><span class="caret"></span></p></div>
          </div>
          <div class="window term" aria-hidden="true">
            <div class="titlebar"><i></i><i></i><i></i><span>~/site · claude</span></div>
            <div class="doc tty"><p class="doc-line dim">✻ Ready. What should we build?</p><p class="doc-line now"><span class="prompt">›</span> <span class="doc-text"></span><span class="caret"></span></p></div>
          </div>
          <canvas class="scene-orb" aria-hidden="true"></canvas>
          <div class="dock" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
        </div>
        <div class="keys" aria-hidden="true"><div class="fnkey">fn</div><span>Hold</span></div>
        </div>
        <p class="spec">
          <span><b>0.5 s</b> from letting go to text</span>
          <span><b>6.1%</b> of words wrong, <a href="/bench">on the bench</a></span>
          <span><b>25</b> languages</span>
          <span><b>0 bytes</b> of your voice leave your Mac</span>
        </p>
      </div>
    </section>

    <section class="block" aria-labelledby="app-title">
      <div class="wrap">
        <div class="head">
          <h2 id="app-title">It lives in your menu bar</h2>
          <p class="intro">A small native app, written in Rust. Use any microphone, keep every take on your Mac, and teach it the words it gets wrong.</p>
        </div>
        <div class="app-grid">
          <figure class="shot">
            <img src="/app-models.webp" width="2000" height="1334" alt="Heyra's Home with the voice model menu open: Bark 3.0 Clean in use, Fluid Speech Mini and Parakeet v3 on this Mac, and today's words below." loading="lazy" decoding="async" />
            <figcaption>Three voice models: tidy English, every word, or 25 languages</figcaption>
          </figure>
        </div>
        <div class="pieces">
            <figure>
              <img src="/words-box.webp" width="1124" height="160" alt="The words box above the dot, showing a sentence as it's spoken." loading="lazy" decoding="async" />
              <figcaption>Your words show above the dot while you talk</figcaption>
            </figure>
            <figure>
              <img src="/copy-card.webp" width="924" height="132" alt="A card reading Nowhere to type, with the take and a Copy button." loading="lazy" decoding="async" />
              <figcaption>Nowhere to type? It holds the take for you to copy</figcaption>
            </figure>
        </div>
      </div>
    </section>

    <section class="block privacy-block" id="private" aria-labelledby="private-title">
      <div class="wrap">
        <div class="head">
          <h2 id="private-title">Your voice stays on your Mac</h2>
          <p class="intro">The speech model runs on your Mac, so it works with Wi-Fi off. No account, and the code is open, MIT. The only download is the model, once, from GitHub, checked against a fingerprint.</p>
        </div>
      </div>
    </section>

    <section class="block band" id="developers" aria-labelledby="dev-title">
      <div class="wrap split server-split">
        <div>
          <pre><code id="curl">{curl}</code></pre>
          <div class="dev-links">
            <a class="btn ghost small" href={SERVER_CODE}>Server code</a>
            <a class="btn ghost small" href="/llms.txt">llms.txt</a>
            <button id="forget" class="btn ghost small" type="button">Use a key in the demo</button>
          </div>
          <form id="key" hidden>
            <input type="password" autocomplete="off" spellcheck="false" placeholder="Heyra key" aria-label="Heyra key" />
            <button class="btn ghost small" type="submit">Use key</button>
          </form>
          <p class="demo-note">The orb at the top of this page is a live demo. It sends your clip to this server, which writes it down and doesn't keep it. The Mac app sends nothing at all.</p>
        </div>
        <div>
          <h2 id="dev-title">The same engine, for everything else</h2>
          <p class="intro">Run Heyra on a server for anything that can't run a model itself. Send a WAV, get the words back.</p>
          <p class="uses">For microcontrollers, web pages, shell scripts, home automation and agents.</p>
        </div>
      </div>
    </section>

    <section class="block" id="faq" aria-labelledby="faq-title">
      <div class="wrap faq-wrap">
        <div>
          <h2 id="faq-title">Questions</h2>
        </div>
        <div class="faq">
          {faq.map(([q, a]) => (
            <details>
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="closing" aria-labelledby="end-title">
      <div class="wrap">
        <h2 id="end-title">Talk to your Mac</h2>
        <div class="actions closing-actions">
          <a class="btn primary" href={MAC}>
            <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M11.2 8.5c0-1.6 1.3-2.4 1.4-2.5-.8-1.1-2-1.3-2.4-1.3-1-.1-2 .6-2.5.6s-1.3-.6-2.2-.6C4.3 4.7 3.2 5.4 2.6 6.5c-1.2 2.1-.3 5.2.9 6.9.6.8 1.2 1.7 2.1 1.7.8 0 1.2-.5 2.2-.5s1.3.5 2.2.5 1.5-.8 2-1.7c.6-.9.9-1.8.9-1.9-.1 0-1.7-.7-1.7-3zM9.6 3.6c.4-.5.8-1.3.7-2-.7 0-1.5.4-1.9 1-.4.5-.8 1.2-.7 2 .7 0 1.4-.4 1.9-1z"/></svg>
            Download for Mac
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <script src="/heyra.js" type="module"></script>
  <script src="/journey.js" defer></script>
  <script src="/ascii-wave.js" defer></script>
  <script src="/scene.js" type="module"></script>
  <script src="/copy-brew.js" defer></script>
</body>
</html>
