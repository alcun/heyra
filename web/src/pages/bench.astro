---
// The bench: how many words each voice model gets wrong, as static bars. Everything
// here is in the markup at build time, so nothing moves after the page loads.
import "../styles/base.css";
import { deflateSync } from "node:zlib";
import bench from "../data/bench.json";
import Analytics from "../components/Analytics.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const MAC = "https://github.com/alcun/heyra-desktop";
const analyticsKey = import.meta.env.HEYRA_LOGGERLIZARD_KEY;
const site = Astro.site;
const canonical = site ? new URL("/bench", site).href : undefined;

// A 4x4 ordered-dither tile as a PNG data URI: one look per model.
const BAYER = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5];
const crcTable = Array.from({ length: 256 }, (_, n) => {
  let c = n;
  for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
  return c >>> 0;
});
const crc = (buf: Uint8Array) => {
  let c = 0xffffffff;
  for (const b of buf) c = crcTable[(c ^ b) & 0xff] ^ (c >>> 8);
  return (c ^ 0xffffffff) >>> 0;
};
function chunk(type: string, data: Uint8Array) {
  const out = new Uint8Array(12 + data.length);
  const view = new DataView(out.buffer);
  view.setUint32(0, data.length);
  out.set(new TextEncoder().encode(type), 4);
  out.set(data, 8);
  view.setUint32(8 + data.length, crc(out.subarray(4, 8 + data.length)));
  return out;
}
function tile(hex: string, density: number) {
  const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
  const raw = new Uint8Array(4 * 17);
  for (let y = 0; y < 4; y++)
    for (let x = 0; x < 4; x++)
      if (BAYER[y * 4 + x] < density * 16) raw.set([r, g, b, 255], y * 17 + 1 + x * 4);
  const ihdr = new Uint8Array(13);
  new DataView(ihdr.buffer).setUint32(0, 4);
  new DataView(ihdr.buffer).setUint32(4, 4);
  ihdr.set([8, 6, 0, 0, 0], 8);
  const parts = [new Uint8Array([137, 80, 78, 71, 13, 10, 26, 10]), chunk("IHDR", ihdr), chunk("IDAT", deflateSync(raw)), chunk("IEND", new Uint8Array())];
  const png = new Uint8Array(parts.reduce((n, p) => n + p.length, 0));
  let at = 0;
  for (const p of parts) { png.set(p, at); at += p.length; }
  return `url(data:image/png;base64,${Buffer.from(png).toString("base64")})`;
}

const models = bench.models.map((m) => ({ ...m, fill: tile(m.color, m.density) }));
const model = Object.fromEntries(models.map((m) => [m.id, m]));
const width = (v: number, max: number) => `${Math.min(100, (v / max) * 100).toFixed(2)}%`;
// Shaped here, so the markup below only loops.
const duos = bench.duos.map((d) => ({
  ...d,
  rows: (d.rows as [string, number, string][]).map(([name, v, id], i, all) => ({ name, v, fill: model[id].fill, win: i === all.length - 1 })),
}));
// The neutral dither for every model but the one a figure is about, which gets gold.
const quiet = tile("#8a9aa6", 0.5);
const gold = tile("#d9a86a", 0.875);
const set = (name: string) => bench.sets.find((x) => x.name === name)!.v as Record<string, number>;
const meant = set("Off the cuff, meant");
const average = set("Average");
// The answer, from the numbers.
const answer = [
  { when: "To talk and get what you meant", id: "clean", value: meant.clean, of: "off the cuff, against what people meant" },
  { when: "Every word, word for word", id: "fluid", value: average.fluid, of: "averaged over seven public sets" },
  { when: "In another language", id: "parakeet", value: average.parakeet, of: "averaged, and 25 languages" },
];
// The main chart: the seven-set average, the lowest in gold.
const best = Object.entries(average).reduce((a, b) => (b[1] < a[1] ? b : a))[0];
const main = models.map((m) => ({ m, v: average[m.id], lead: m.id === best })).filter((r) => r.v !== undefined).sort((a, b) => a.v - b.v);
const mainMax = Math.max(...main.map((r) => r.v));
const sets = bench.sets.map((s) => {
  const v = s.v as Record<string, number>;
  const low = Math.min(...Object.values(v));
  return { ...s, cells: models.map((m) => ({ m, v: v[m.id], win: v[m.id] === low })) };
});
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Heyra Bench · Which voice model should you use?</title>
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:title" content="Heyra Bench · Which voice model should you use?" />
  <meta property="og:description" content={`Words wrong in 100 for each voice model in Heyra, on ${bench.clips} public English clips.`} />
  {site && <meta property="og:image" content={new URL("/og.png", site).href} />}
  {site && <meta name="twitter:card" content="summary_large_image" />}
  <meta name="description" content={`How many words each voice model in Heyra gets wrong, on ${bench.clips} public English clips.`} />
  <link rel="preload" href="/fonts/Outland-Bold.otf" as="font" type="font/otf" crossorigin />
  <link rel="preload" href="/fonts/SpaceGrotesk-Regular.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/MartianMono-StdMd.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
  {analyticsKey && <Analytics publicKey={analyticsKey} />}
  <style is:global>
    main { max-width: 60rem; margin: 0 auto; padding: 6.5rem max(1rem, 4vw) 6rem; display: grid; gap: 4.5rem; }
    section { display: grid; gap: 1.25rem; min-width: 0; }
    h1 { font-size: clamp(1.8rem, 4.4vw, 2.8rem); line-height: 1.15; margin: 0; text-wrap: balance; }
    h2 { margin: 0; font: 700 clamp(1.2rem, 2vw, 1.5rem)/1.25 var(--display); letter-spacing: 0.05em; color: var(--cream); }
    .small { margin: 0; color: var(--slate); font-size: 0.95rem; line-height: 1.55; max-width: 44rem; }
    .meta { margin: 0; color: var(--dim); font: 400 0.8rem/1.5 var(--mono); }
    .top { display: grid; gap: 1rem; }
    #wave { width: 100%; height: 6rem; display: block; image-rendering: pixelated; }
    /* The point of a figure, in words: glyph-kit's ► line, in the gold of the signature. */
    .point { margin: 0; font: 400 0.95rem/1.5 var(--sans); color: var(--cream); }
    .point::before { content: "► "; color: var(--gold); }

    /* The answer: three cards, the model and its one number. */
    .answer { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    .pick { background: var(--panel); border: 1px solid var(--hair); border-radius: 14px; padding: 20px; display: grid; gap: 10px; align-content: start; }
    .pick .when { color: var(--slate); font-size: 0.9rem; }
    .pick b { font: 700 1.05rem/1.25 var(--display); letter-spacing: 0.05em; color: var(--cream); }
    .pick .num { font: 500 1.9rem/1 var(--mono); font-variant-numeric: tabular-nums; color: var(--cream); }
    .pick .num small { font-size: 0.8rem; color: var(--dim); margin-left: 0.35rem; }
    .pick .of { color: var(--dim); font-size: 0.82rem; }
    .pick:first-child { border-color: rgb(217 168 106 / 0.45); }
    .pick:first-child .num { color: var(--gold); }

    /* The main chart: one bar per model, the lead in gold, the rest quiet. */
    .chart { display: grid; gap: 12px; padding: 20px; background: var(--panel); border: 1px solid var(--hair); border-radius: 14px; }
    .bar { display: grid; grid-template-columns: 13rem minmax(0, 1fr) 3.5rem; gap: 16px; align-items: center; }
    .bar .n { font-size: 0.95rem; color: var(--slate); }
    .bar .t { height: 16px; }
    .bar .b { height: 100%; min-width: 2px; background-size: 4px 4px; image-rendering: pixelated; }
    .bar .v { font: 500 0.95rem var(--mono); font-variant-numeric: tabular-nums; text-align: right; color: var(--slate); }
    .bar.lead .n, .bar.lead .v { color: var(--cream); }

    /* Every kind of speech: one table, a number and a thin bar per cell, the best per row in gold. */
    .sets { width: 100%; border-collapse: collapse; background: var(--panel); border: 1px solid var(--hair); border-radius: 14px; overflow: hidden; }
    .sets th, .sets td { padding: 12px 16px; border-top: 1px solid var(--hair); text-align: left; vertical-align: middle; }
    .sets thead th { border-top: 0; font: 500 0.85rem/1.3 var(--sans); color: var(--slate); }
    .sets th[scope="row"] { font-weight: 400; font-size: 0.95rem; color: var(--cream); white-space: nowrap; }
    .sets th[scope="row"] span { display: block; font: 400 0.75rem var(--mono); color: var(--dim); }
    .sets td { width: 17%; }
    .sets .v { font: 500 0.9rem var(--mono); font-variant-numeric: tabular-nums; color: var(--slate); }
    .sets .best .v { color: var(--gold); }
    .sets .t { height: 4px; margin-top: 6px; background: rgb(255 255 255 / 0.05); border-radius: 2px; }
    .sets .t i { display: block; height: 100%; border-radius: 2px; background: var(--slate); opacity: 0.6; }
    .sets .best .t i { background: var(--gold); opacity: 1; }
    .sets .none { color: var(--dim); font: 0.9rem var(--mono); }
    .wide { overflow-x: auto; border-radius: 14px; }

    /* Side by side: what was said, and what each model wrote. */
    .clips { display: grid; gap: 12px; }
    .clip { background: var(--panel); border: 1px solid var(--hair); border-radius: 14px; padding: 20px; display: grid; gap: 8px; }
    .clip h3 { margin: 0 0 4px; font: 500 0.95rem var(--sans); color: var(--cream); }
    .line { display: grid; grid-template-columns: 8.5rem minmax(0, 1fr); gap: 16px; align-items: baseline; font-size: 0.95rem; }
    .line .who { font: 400 0.8rem var(--mono); color: var(--dim); }
    .line.said span:last-child { color: var(--slate); }
    .line.win .who { color: var(--gold); }
    .line.empty span:last-child { color: var(--dim); font-style: normal; }

    /* Under the hood: three small facts, quieter than the rest. */
    .hood { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    .fact { border: 1px solid var(--hair); border-radius: 14px; padding: 16px; display: grid; gap: 8px; align-content: start; }
    .fact h3 { margin: 0; font: 500 0.9rem var(--sans); color: var(--cream); }
    .row { display: grid; grid-template-columns: 6rem minmax(0, 1fr) 2.8rem; gap: 10px; align-items: center; }
    .row .n { font-size: 0.82rem; color: var(--slate); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .row .t { height: 8px; position: relative; }
    .row .b { height: 100%; min-width: 2px; background-size: 4px 4px; image-rendering: pixelated; }
    .row .v { font: 500 0.82rem var(--mono); font-variant-numeric: tabular-nums; text-align: right; color: var(--slate); }
    .row.win .n, .row.win .v { color: var(--cream); }
    .fact .small { font-size: 0.82rem; }

    ul.method { margin: 0; padding-left: 1.1rem; color: var(--slate); font-size: 0.95rem; display: grid; gap: 6px; }
    @media (max-width: 48rem) {
      .answer, .hood { grid-template-columns: minmax(0, 1fr); }
      .bar { grid-template-columns: 8rem minmax(0, 1fr) 3rem; }
      .line { grid-template-columns: minmax(0, 1fr); gap: 0; }
    }
  </style>
</head>
<body>
  <Header current="bench" />

  <main>
    <section class="top">
      <canvas id="wave" aria-hidden="true"></canvas>
      <h1>Which voice model should you use?</h1>
      <p class="meta">heyra-bench · {bench.clips} public English clips · {bench.date} · words wrong in 100, fewer is better</p>
    </section>

    <section aria-label="The answer">
      <div class="answer">
        {answer.map((a) => (
          <div class="pick">
            <span class="when">{a.when}</span>
            <b>{model[a.id].name}</b>
            <span class="num">{a.value.toFixed(1)}<small>in 100 wrong</small></span>
            <span class="of">{a.of}</span>
          </div>
        ))}
      </div>
      <p class="small">Leaderboard transcripts keep every “um”, so Bark Clean, which leaves them out on purpose, scores worse on those sets by design.</p>
    </section>

    <section aria-labelledby="avg-title">
      <h2 id="avg-title">Words wrong, word for word</h2>
      <div class="chart">
        {main.map((r) => (
          <div class={r.lead ? "bar lead" : "bar"}>
            <span class="n">{r.m.name}</span>
            <div class="t"><div class="b" style={`width:${width(r.v, mainMax)};background-image:${r.lead ? gold : quiet}`}></div></div>
            <span class="v">{r.v.toFixed(1)}</span>
          </div>
        ))}
      </div>
      <p class="point">{model[best].name} gets the fewest words wrong: {average[best].toFixed(1)} in 100, averaged over seven public sets. The old engine got {average.old.toFixed(1)}.</p>
    </section>

    <section aria-labelledby="sets-title">
      <h2 id="sets-title">Every kind of speech</h2>
      <div class="wide">
        <table class="sets">
          <thead><tr><th scope="col">Speech</th>{models.map((m) => <th scope="col">{m.name}</th>)}</tr></thead>
          <tbody>
            {sets.filter((x) => x.name !== "Average").map((x) => (
              <tr>
                <th scope="row">{x.name}<span>{x.source}</span></th>
                {x.cells.map((c) => c.v === undefined ? <td class="none">–</td> : (
                  <td class={c.win ? "best" : undefined} title={`${c.m.name}: ${c.v.toFixed(2)} words wrong in 100`}>
                    <span class="v">{c.v.toFixed(1)}</span>
                    <div class="t"><i style={`width:${width(c.v, 30)}`}></i></div>
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="point">No one model wins everywhere: the best in each kind of speech is in gold.</p>
    </section>

    <section aria-labelledby="side-title">
      <h2 id="side-title">Side by side</h2>
      <div class="clips">
        {bench.clips_shown.map((c) => (
          <div class="clip">
            <h3>{c.kind}</h3>
            {c.lines.map(([who, text, kind]) => (
              <div class={`line ${kind}`}><span class="who">{who}</span><span>{kind === "empty" ? "Nothing" : text}</span></div>
            ))}
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="hood-title">
      <h2 id="hood-title">Under the hood</h2>
      <div class="hood">
        {duos.map((d) => (
          <div class="fact">
            <h3>{d.title}</h3>
            {d.rows.map((r) => (
              <div class={r.win ? "row win" : "row"}>
                <span class="n">{r.name}</span>
                <div class="t"><div class="b" style={`width:${width(r.v, d.max)};background-image:${r.win ? gold : quiet}`}></div></div>
                <span class="v">{r.v.toFixed(1)}</span>
              </div>
            ))}
            <p class="small">{d.note}</p>
          </div>
        ))}
      </div>
      <p class="small">{bench.wait}</p>
    </section>

    <section aria-labelledby="method-title">
      <h2 id="method-title">Method</h2>
      <ul class="method">
        <li>100 clips each: LibriSpeech, AMI, Earnings-22, GigaSpeech, SPGISpeech, VoxPopuli, DisfluencySpeech.</li>
        <li>{bench.engine}, as in Heyra. Lower-cased, no punctuation.</li>
      </ul>
    </section>
  </main>

  <Footer />

  <script src="/wave.js" type="module"></script>
</body>
</html>
