---
// The bench: how many words each voice model gets wrong. Everything is in the markup at
// build time; a small script then lets you pick a kind of speech (the bars re-rank), see
// speed against accuracy, and play clips with each model's mistakes marked.
import "../styles/base.css";
import { deflateSync } from "node:zlib";
import bench from "../data/bench.json";
import Analytics from "../components/Analytics.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const MAC = "https://github.com/alcun/heyra-desktop";
const analyticsKey = import.meta.env.HEYRA_LOGGERLIZARD_KEY;
const site = Astro.site;
const canonical = site ? new URL("/bench", site).href : undefined;

// A 4x4 ordered-dither tile as a PNG data URI: one look per model.
const BAYER = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5];
const crcTable = Array.from({ length: 256 }, (_, n) => {
  let c = n;
  for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
  return c >>> 0;
});
const crc = (buf: Uint8Array) => {
  let c = 0xffffffff;
  for (const b of buf) c = crcTable[(c ^ b) & 0xff] ^ (c >>> 8);
  return (c ^ 0xffffffff) >>> 0;
};
function chunk(type: string, data: Uint8Array) {
  const out = new Uint8Array(12 + data.length);
  const view = new DataView(out.buffer);
  view.setUint32(0, data.length);
  out.set(new TextEncoder().encode(type), 4);
  out.set(data, 8);
  view.setUint32(8 + data.length, crc(out.subarray(4, 8 + data.length)));
  return out;
}
function tile(hex: string, density: number) {
  const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
  const raw = new Uint8Array(4 * 17);
  for (let y = 0; y < 4; y++)
    for (let x = 0; x < 4; x++)
      if (BAYER[y * 4 + x] < density * 16) raw.set([r, g, b, 255], y * 17 + 1 + x * 4);
  const ihdr = new Uint8Array(13);
  new DataView(ihdr.buffer).setUint32(0, 4);
  new DataView(ihdr.buffer).setUint32(4, 4);
  ihdr.set([8, 6, 0, 0, 0], 8);
  const parts = [new Uint8Array([137, 80, 78, 71, 13, 10, 26, 10]), chunk("IHDR", ihdr), chunk("IDAT", deflateSync(raw)), chunk("IEND", new Uint8Array())];
  const png = new Uint8Array(parts.reduce((n, p) => n + p.length, 0));
  let at = 0;
  for (const p of parts) { png.set(p, at); at += p.length; }
  return `url(data:image/png;base64,${Buffer.from(png).toString("base64")})`;
}



type M = (typeof bench.models)[number];
const models = bench.models as M[];
const model = Object.fromEntries(models.map((m) => [m.id, m]));
const width = (v: number, max: number) => `${Math.min(100, (v / max) * 100).toFixed(2)}%`;
const quiet = tile("#8a9aa6", 0.5);
const gold = tile("#d9a86a", 0.875);
const low = (list: M[], v: (m: M) => number | null | undefined) =>
  list.filter((m) => v(m) != null).reduce((a, b) => (v(b)! < v(a)! ? b : a));
// The answer, from the numbers.
const meantBest = low(models, (m) => m.v["disfluency-meant"]);
const avgBest = low(models, (m) => m.average);
const otherBest = low(models.filter((m) => m.langs !== "English"), (m) => m.average);
const answer = [
  { when: "To talk and get what you meant", m: meantBest, value: meantBest.v["disfluency-meant"], of: "off the cuff, against what people meant" },
  { when: "Every word, word for word", m: avgBest, value: avgBest.average!, of: "averaged over seven public sets" },
  { when: "In another language", m: otherBest, value: otherBest.average!, of: `averaged, and ${otherBest.langs}` },
];
// Pick your speech: the average first, then each set.
const views = [{ id: "average", name: "Average", source: "seven public sets" }, ...bench.sets];
const valueOf = (m: M, id: string) => (id === "average" ? m.average : m.v[id]) ?? null;
const ranked = models.filter((m) => m.average != null).sort((a, b) => a.average! - b.average!);
const rankMax = 30;
// Speed against accuracy: speed on a log scale, words wrong up the side.
const plot = { w: 640, h: 360, l: 48, r: 24, t: 20, b: 44 };
const speeds = ranked.map((m) => m.speed);
const [s0, s1] = [Math.min(...speeds) / 1.4, Math.max(...speeds) * 1.4];
const avgs = ranked.map((m) => m.average!);
const [w0, w1] = [Math.max(0, Math.floor(Math.min(...avgs)) - 1), Math.ceil(Math.max(...avgs)) + 1];
const sx = (s: number) => plot.l + ((Math.log(s) - Math.log(s0)) / (Math.log(s1) - Math.log(s0))) * (plot.w - plot.l - plot.r);
const sy = (v: number) => plot.t + ((v - w0) / (w1 - w0)) * (plot.h - plot.t - plot.b);
const ticksX = [2, 5, 10, 20, 50, 100, 200, 500].filter((t) => t >= s0 && t <= s1);
const step = w1 - w0 > 12 ? 5 : 2;
const ticksY = Array.from({ length: 40 }, (_, i) => Math.ceil(w0 / step) * step + i * step).filter((t) => t <= w1);
const dots = ranked.map((m) => ({ m, x: sx(m.speed), y: sy(m.average!), r: 4 + Math.sqrt(m.mb) / 6, ly: 0 }));
// Labels: beside each dot, pushed apart so none overlap.
for (const d of dots) d.ly = d.y + 4;
const byY = [...dots].sort((a, b) => a.ly - b.ly);
for (let pass = 0; pass < 20; pass++)
  for (let i = 1; i < byY.length; i++) {
    const [a, b] = [byY[i - 1], byY[i]];
    if (Math.abs(a.x - b.x) < 150 && b.ly - a.ly < 14) { const push = (14 - (b.ly - a.ly)) / 2; a.ly -= push; b.ly += push; }
  }
const duos = bench.duos.map((d) => ({
  ...d,
  rows: (d.rows as [string, number, string][]).map(([name, v], i, all) => ({ name, v, win: i === all.length - 1 })),
}));
const data = { models: models.map(({ id, name, langs, heyra, mb, speed, average, v }) => ({ id, name, langs, heyra, mb, speed, average, v })), rankMax };
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Heyra Bench · Which voice model should you use?</title>
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:title" content="Heyra Bench · Which voice model should you use?" />
  <meta property="og:description" content={`Words wrong in 100 for ${models.length} voice models, on ${bench.clips} public English clips.`} />
  {site && <meta property="og:image" content={new URL("/og.jpg", site).href} />}
  {site && <meta name="twitter:card" content="summary_large_image" />}
  <meta name="description" content={`How many words ${models.length} voice models get wrong, and how fast, on ${bench.clips} public English clips.`} />
  <link rel="preload" href="/fonts/Outland-Bold.otf" as="font" type="font/otf" crossorigin />
  <link rel="preload" href="/fonts/SpaceGrotesk-Regular.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/MartianMono-StdMd.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
  {analyticsKey && <Analytics publicKey={analyticsKey} />}
  <style is:global>
    main { max-width: 60rem; margin: 0 auto; padding: 6.5rem max(1rem, 4vw) 6rem; display: grid; gap: 5rem; }
    section { display: grid; gap: 1.25rem; min-width: 0; }
    h1 { font-size: clamp(2rem, 5vw, 3.2rem); line-height: 1.12; margin: 0; text-wrap: balance; }
    h2 { margin: 0; font: 700 clamp(1.5rem, 3vw, 2.2rem)/1.15 var(--display); letter-spacing: 0.05em; color: var(--cream); }
    .small { margin: 0; color: var(--slate); font-size: 0.95rem; line-height: 1.55; max-width: 44rem; }
    .meta { margin: 0; color: var(--dim); font: 400 0.8rem/1.5 var(--mono); }
    .top { display: grid; gap: 1rem; }
    #wave { width: 100%; height: 6rem; display: block; image-rendering: pixelated; }
    .point { margin: 0; font: 400 0.95rem/1.5 var(--sans); color: var(--cream); }
    .point::before { content: "► "; color: var(--gold); }
    .panel { background: var(--panel); border: 1px solid var(--hair); border-radius: 14px; }

    /* The answer: three cards, the model and its one number. */
    .answer { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    .pick { padding: 20px; display: grid; gap: 10px; align-content: start; }
    .pick .when { color: var(--slate); font-size: 0.9rem; }
    .pick b { font: 700 1.05rem/1.25 var(--display); letter-spacing: 0.05em; color: var(--cream); }
    .pick .num { font: 500 1.9rem/1 var(--mono); font-variant-numeric: tabular-nums; color: var(--cream); }
    .pick .num small { font-size: 0.8rem; color: var(--dim); margin-left: 0.35rem; }
    .pick .of { color: var(--dim); font-size: 0.82rem; }
    .pick:first-child { border-color: rgb(217 168 106 / 0.45); }
    .pick:first-child .num { color: var(--gold); }

    /* Pick your speech: chips, then bars that re-rank. */
    .chips { display: flex; flex-wrap: wrap; gap: 8px; }
    .chip { font: 500 0.85rem/1 var(--sans); color: var(--slate); background: transparent; border: 1px solid var(--hair); border-radius: 999px; padding: 0.55rem 0.9rem; cursor: pointer; transition: color 0.15s, border-color 0.15s, background 0.15s; }
    .chip:hover { color: var(--cream); }
    .chip[aria-pressed="true"] { color: #111216; background: var(--cream); border-color: var(--cream); }
    .rank { --row: 46px; position: relative; height: calc(var(--n) * var(--row) + 28px); }
    .bar { position: absolute; left: 20px; right: 20px; top: 14px; transform: translateY(calc(var(--i) * var(--row))); display: grid; grid-template-columns: 1.6rem 15rem minmax(0, 1fr) 3.5rem; grid-template-areas: "pos n t v"; gap: 14px; align-items: center; height: var(--row); transition: transform 0.6s var(--ease), opacity 0.3s; }
    .bar .pos { grid-area: pos; } .bar .n { grid-area: n; } .bar .t { grid-area: t; } .bar .v { grid-area: v; }
    .bar .pos { font: 500 0.8rem var(--mono); color: var(--dim); text-align: right; }
    .bar .n { display: grid; gap: 2px; min-width: 0; }
    .bar .n b { font: 500 0.95rem/1.2 var(--sans); color: var(--cream); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .bar .n span { font: 400 0.72rem/1.2 var(--mono); color: var(--dim); white-space: nowrap; }
    .bar .n .in { color: var(--gold); }
    .bar .t { height: 14px; }
    .bar .b { height: 100%; min-width: 2px; background-size: 4px 4px; image-rendering: pixelated; transition: width 0.6s var(--ease); }
    .bar .v { font: 500 0.95rem var(--mono); font-variant-numeric: tabular-nums; text-align: right; color: var(--slate); }
    .bar.lead .v { color: var(--gold); }
    .bar.none { opacity: 0.35; }

    /* Speed against accuracy. */
    .plot { padding: 12px; position: relative; }
    .plot svg { display: block; width: 100%; height: auto; overflow: visible; }
    .plot .grid { stroke: var(--hair); stroke-width: 1; }
    .plot .tick { fill: var(--dim); font: 400 11px var(--mono); text-transform: none; }
    .plot .axis { fill: var(--slate); font: 400 12px var(--sans); text-transform: none; letter-spacing: 0; }
    .plot .dot { fill: rgb(138 154 166 / 0.35); stroke: var(--slate); stroke-width: 1.2; cursor: pointer; transition: r 0.2s, fill 0.2s; }
    .plot .dot.heyra { fill: rgb(217 168 106 / 0.35); stroke: var(--gold); }
    .plot g:hover .dot, .plot g:focus .dot { fill: var(--cream); }
    .plot .name { fill: var(--slate); font: 400 11px var(--sans); text-transform: none; letter-spacing: 0; pointer-events: none; }
    .plot g.heyra .name { fill: var(--cream); }
    .plot g { outline: none; }

    /* Listen: a clip, then what each model wrote, mistakes marked. */
    .clip-tabs { display: flex; flex-wrap: wrap; gap: 8px; }
    .clip { padding: 20px; display: grid; gap: 14px; }
    .clip[hidden] { display: none; }
    .player { display: flex; align-items: center; gap: 14px; }
    .play { width: 3rem; height: 3rem; border-radius: 50%; border: 0; background: var(--cream); color: #111216; display: grid; place-items: center; cursor: pointer; flex: none; transition: transform 0.15s; }
    .play:hover { transform: scale(1.05); }
    .play svg { width: 1.1rem; height: 1.1rem; }
    .play .pause { display: none; }
    .play.on .pause { display: block; }
    .play.on .go { display: none; }
    .track { flex: 1; height: 4px; border-radius: 2px; background: var(--hair); overflow: hidden; }
    .track i { display: block; height: 100%; width: 0; background: var(--gold); }
    .player .src { font: 400 0.75rem var(--mono); color: var(--dim); white-space: nowrap; }
    .said { margin: 0; color: var(--cream); font-size: 1.05rem; line-height: 1.5; }
    .takes { display: grid; gap: 2px; }
    .take { display: grid; grid-template-columns: 11rem 2rem minmax(0, 1fr); gap: 12px; align-items: baseline; padding: 6px 0; border-top: 1px solid var(--hair); font-size: 0.92rem; }
    .take .who { font: 400 0.78rem var(--mono); color: var(--slate); }
    .take.heyra .who { color: var(--gold); }
    .take .w { font: 500 0.78rem var(--mono); color: var(--dim); text-align: right; }
    .take .w.zero { color: #8fbf8a; }
    .take p { margin: 0; color: var(--slate); line-height: 1.55; }
    .take p .s { color: #e0795a; text-decoration: underline wavy rgb(224 121 90 / 0.6); text-underline-offset: 3px; }
    .take p .a { color: #e0795a; }
    .take p .m { color: var(--dim); text-decoration: line-through; }
    .key { display: flex; flex-wrap: wrap; gap: 6px 18px; font: 400 0.78rem var(--mono); color: var(--dim); }
    .key .s { color: #e0795a; text-decoration: underline wavy rgb(224 121 90 / 0.6); }
    .key .a { color: #e0795a; }
    .key .m { text-decoration: line-through; }

    /* Under the hood: three small facts, quieter than the rest. */
    .hood { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    .fact { border: 1px solid var(--hair); border-radius: 14px; padding: 16px; display: grid; gap: 8px; align-content: start; }
    .fact h3 { margin: 0; font: 500 0.9rem var(--sans); color: var(--cream); }
    .row { display: grid; grid-template-columns: 6rem minmax(0, 1fr) 2.8rem; gap: 10px; align-items: center; }
    .row .n { font-size: 0.82rem; color: var(--slate); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .row .t { height: 8px; position: relative; }
    .row .b { height: 100%; min-width: 2px; background-size: 4px 4px; image-rendering: pixelated; }
    .row .v { font: 500 0.82rem var(--mono); font-variant-numeric: tabular-nums; text-align: right; color: var(--slate); }
    .row.win .n, .row.win .v { color: var(--cream); }
    .fact .small { font-size: 0.82rem; }

    ul.method { margin: 0; padding-left: 1.1rem; color: var(--slate); font-size: 0.95rem; display: grid; gap: 6px; }
    @media (max-width: 48rem) {
      .answer, .hood { grid-template-columns: minmax(0, 1fr); }
      .rank { --row: 64px; }
      .bar { left: 14px; right: 14px; grid-template-columns: 1.2rem minmax(0, 1fr) 2.8rem; grid-template-areas: "pos n v" ". t t"; gap: 4px 10px; align-content: center; }
      .plot { overflow-x: auto; }
      .plot svg { min-width: 560px; }
      .take { grid-template-columns: minmax(0, 1fr) 2rem; }
      .take p { grid-column: 1 / -1; }
    }
    @media (prefers-reduced-motion: reduce) { .bar, .bar .b { transition: none; } }
  </style>
</head>
<body>
  <Header current="bench" />

  <main>
    <section class="top">
      <canvas id="wave" aria-hidden="true"></canvas>
      <h1>Which voice model should you use?</h1>
      <p class="meta">heyra-bench · {models.length} models · {bench.clips} public English clips · {bench.date} · words wrong in 100, fewer is better</p>
    </section>

    <section aria-label="The answer">
      <div class="answer">
        {answer.map((a) => (
          <div class="pick panel">
            <span class="when">{a.when}</span>
            <b>{a.m.name}</b>
            <span class="num">{a.value.toFixed(1)}<small>in 100 wrong</small></span>
            <span class="of">{a.of}</span>
          </div>
        ))}
      </div>
      <p class="small">Leaderboard transcripts keep every “um”, so Bark Clean, which leaves them out on purpose, scores worse on those sets by design.</p>
    </section>

    <section aria-labelledby="rank-title">
      <h2 id="rank-title">Pick your speech</h2>
      <div class="chips" role="group" aria-label="Kind of speech">
        {views.map((v, i) => <button type="button" class="chip" data-view={v.id} aria-pressed={i === 0 ? "true" : "false"} title={v.source}>{v.name}</button>)}
      </div>
      <div class="rank panel" id="rank" style={`--n:${ranked.length}`}>
        {ranked.map((m, i) => (
          <div class={i === 0 ? "bar lead" : "bar"} data-id={m.id} style={`--i:${i}`}>
            <span class="pos">{i + 1}</span>
            <span class="n"><b>{m.name}</b><span>{m.langs}{m.heyra && <> · <span class="in">in Heyra</span></>}</span></span>
            <div class="t"><div class="b" style={`width:${width(m.average!, rankMax)};background-image:${m.heyra ? gold : quiet}`}></div></div>
            <span class="v">{m.average!.toFixed(1)}</span>
          </div>
        ))}
      </div>
      <p class="point" id="rank-point">{ranked[0].name} gets the fewest words wrong on average: {ranked[0].average!.toFixed(1)} in 100. Gold bars are the models in Heyra.</p>
    </section>

    <section aria-labelledby="plot-title">
      <h2 id="plot-title">Speed and size</h2>
      <div class="plot panel">
        <svg viewBox={`0 0 ${plot.w} ${plot.h}`} role="img" aria-label="Each model's speed against the words it gets wrong">
          {ticksY.map((t) => <><line class="grid" x1={plot.l} x2={plot.w - plot.r} y1={sy(t)} y2={sy(t)} /><text class="tick" x={plot.l - 8} y={sy(t) + 4} text-anchor="end">{t}</text></>)}
          {ticksX.map((t) => <text class="tick" x={sx(t)} y={plot.h - plot.b + 18} text-anchor="middle">{t}×</text>)}
          <text class="axis" x={(plot.l + plot.w - plot.r) / 2} y={plot.h - 6} text-anchor="middle">faster than real time →</text>
          <text class="axis" x={14} y={plot.t + 4} transform={`rotate(-90 14 ${plot.t + 4})`} text-anchor="end">← fewer words wrong</text>
          {dots.map((d) => (
            <g class={d.m.heyra ? "heyra" : undefined} tabindex="0">
              <title>{`${d.m.name}: ${d.m.average!.toFixed(1)} in 100 wrong, ${d.m.speed}× real time, ${d.m.mb} MB, ${d.m.langs}`}</title>
              <circle class={d.m.heyra ? "dot heyra" : "dot"} cx={d.x} cy={d.y} r={d.r} />
              <text class="name" x={d.x + d.r + 5} y={d.ly}>{d.m.name}</text>
            </g>
          ))}
        </svg>
      </div>
      <p class="point">Up and to the right is better. Bigger dots are bigger downloads; gold are the models in Heyra. Speed is on 4 CPU threads of an M-series Mac.</p>
    </section>

    <section aria-labelledby="listen-title">
      <h2 id="listen-title">Listen</h2>
      <div class="clip-tabs" role="group" aria-label="Clip">
        {bench.listen.map((c, i) => <button type="button" class="chip" data-clip={i} aria-pressed={i === 0 ? "true" : "false"}>{c.kind}</button>)}
      </div>
      {bench.listen.map((c, i) => (
        <div class="clip panel" data-clip-panel={i} hidden={i !== 0}>
          <div class="player">
            <button type="button" class="play" aria-label={`Play the ${c.kind.toLowerCase()} clip`}>
              <svg class="go" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M4 2.5v11l9-5.5z"/></svg>
              <svg class="pause" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M4 2.5h3v11H4zM9 2.5h3v11H9z"/></svg>
            </button>
            <div class="track"><i></i></div>
            <span class="src">{c.source} · {c.secs} s</span>
            <audio src={c.audio} preload="none"></audio>
          </div>
          <p class="said">{c.said}</p>
          <div class="takes">
            {[...c.takes].sort((a, b) => a.wrong - b.wrong).map((t) => (
              <div class={model[t.id]?.heyra ? "take heyra" : "take"}>
                <span class="who">{model[t.id]?.name ?? t.id}</span>
                <span class={t.wrong === 0 ? "w zero" : "w"}>{t.wrong}</span>
                <p>{(t.ops as [string, string][]).map(([k, w]) => k === "k" ? <>{w}{" "}</> : <><span class={k}>{w}</span>{" "}</>)}</p>
              </div>
            ))}
          </div>
          <div class="key"><span>wrong words:</span><span class="s">swapped</span><span class="a">added</span><span class="m">left out</span></div>
        </div>
      ))}
    </section>

    <section aria-labelledby="hood-title">
      <h2 id="hood-title">Under the hood</h2>
      <div class="hood">
        {duos.map((d) => (
          <div class="fact">
            <h3>{d.title}</h3>
            {d.rows.map((r) => (
              <div class={r.win ? "row win" : "row"}>
                <span class="n">{r.name}</span>
                <div class="t"><div class="b" style={`width:${width(r.v, d.max)};background-image:${r.win ? gold : quiet}`}></div></div>
                <span class="v">{r.v.toFixed(1)}</span>
              </div>
            ))}
            <p class="small">{d.note}</p>
          </div>
        ))}
      </div>
      <p class="small">{bench.wait}</p>
    </section>

    <section aria-labelledby="method-title">
      <h2 id="method-title">Method</h2>
      <ul class="method">
        <li>100 clips each: LibriSpeech, AMI, Earnings-22, GigaSpeech, SPGISpeech, VoxPopuli, DisfluencySpeech.</li>
